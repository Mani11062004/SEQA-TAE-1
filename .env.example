# ============================================================
# SecureShield AppSec Platform - Environment Configuration
# ============================================================

# Server Port (automatically assigned by Render in production)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# JWT Authentication Secret Key (replace with a long, secure random string)
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_2026

# Optional: CORS Allowed Origins (comma-separated if hosting frontend separately)
# CORS_ORIGIN=https://my-secureshield-app.onrender.com

# Optional: Frontend API Target (only needed if frontend is hosted on a separate static site)
# VITE_API_URL=https://my-secureshield-api.onrender.com

# Optional: External PostgreSQL Connection (if migrating from SQLite)
# DATABASE_URL=postgres://user:password@host:5432/dbname?ssl=true
